# ==== Twitch ====
# Nome del bot che scrive in chat (puoi usare il tuo stesso account o un account bot dedicato)
TWITCH_BOT_USERNAME=nome_del_bot

# Token OAuth del bot (formato: oauth:xxxxxxxxxxxxxxxxxxxxx)
# Generalo su https://twitchtokengenerator.com (scopes: chat:read, chat:edit)
TWITCH_OAUTH_TOKEN=oauth:xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Il tuo canale Twitch (senza #, es. se sei twitch.tv/miocanale metti miocanale)
TWITCH_CHANNEL=miocanale

# ==== Discord ====
# URL del webhook del canale Discord dove mandare i risultati
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxx/yyyyy

# ==== Sicurezza ====
# Stringa segreta a tua scelta (una password lunga a caso). Protegge /trigger,
# che sarà un URL pubblico su internet una volta ospitato su Render.
# Genera una stringa random, es. con: openssl rand -hex 16
TRIGGER_SECRET=cambiami-con-una-stringa-lunga-a-caso

# ==== Server ====
# In locale puoi lasciare 3939. Su Render questa variabile viene impostata
# automaticamente dalla piattaforma: non serve configurarla nel loro pannello.
PORT=3939

# Durata del sondaggio in secondi
POLL_DURATION_SECONDS=60
